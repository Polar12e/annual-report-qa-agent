# Copy to .env, fill in your own values, and source it. Never commit real keys.
# This file is an example only; the application does not load .env automatically.

# auto | openai | deepseek | local | custom
FIN_AGENT_PROVIDER=deepseek
FIN_AGENT_MODEL=deepseek-flash

# Credentials: set only the one you use.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# FIN_AGENT_API_KEY=   # generic key for a custom OpenAI-compatible gateway

# Optional overrides
# FIN_AGENT_BASE_URL=https://api.deepseek.com
# FIN_AGENT_TIMEOUT=30
# FIN_AGENT_MAX_RETRIES=2
# FIN_AGENT_THINKING=false
# FIN_AGENT_ALLOW_EXTERNAL=false

# Local Ollama example:
# FIN_AGENT_PROVIDER=local
# FIN_AGENT_BASE_URL=http://127.0.0.1:11434/v1
# FIN_AGENT_MODEL=qwen3:8b
